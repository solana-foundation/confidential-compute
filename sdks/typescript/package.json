{
    "name": "@solana/confidential-compute",
    "version": "0.1.0",
    "description": "TypeScript client SDK for Solana Confidential Compute Mode A and Mode B attestation.",
    "license": "Apache-2.0",
    "files": [
        "dist",
        "src"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "test": "bun run build && node --test test/*.test.cjs"
    },
    "dependencies": {
        "@noble/hashes": "^2.4.0",
        "@solana/web3.js": "^3.2.1"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "typescript": "^7.0.2"
    },
    "packageManager": "bun@1.4.4"
}
